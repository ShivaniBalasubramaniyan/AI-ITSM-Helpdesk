# AI-ITSM Helpdesk Backend Environment Configuration

# =====================================================================
# MongoDB Cloud (Atlas) Database Configuration
# =====================================================================
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details.
# Example: mongodb+srv://itsm_user:Password123@itsm-cluster.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=ai_itsm_db

# =====================================================================
# Server Port Configuration
# =====================================================================
PORT=8001
HOST=127.0.0.1

# =====================================================================
# ServiceNow Integration (Optional - Fallbacks to Built-in Mock Router)
# =====================================================================
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
